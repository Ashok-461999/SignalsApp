# SmartAPI credentials (required for live data)
SMARTAPI_API_KEY=your_api_key
SMARTAPI_CLIENT_CODE=your_client_code
SMARTAPI_PASSWORD=your_trading_password
SMARTAPI_TOTP_SECRET=your_totp_secret_base32

# SQLite database path (mounted Docker volume on production)
SQLITE_PATH=/data/signalapp.db

# App
APP_ENV=production
CORS_ORIGINS=*

# Live feed & scheduler
ENABLE_LIVE_FEED=true
ENABLE_SCHEDULER=true
BACKFILL_DAYS=5
SESSION_REFRESH_HOURS=6
GAP_BACKFILL_HOURS=12

# Trading safety — paper mode ON by default
PAPER_TRADING=true
LIVE_EXECUTION_ENABLED=false
KILL_SWITCH=false
RISK_PERCENT=1.0
REQUIRE_BACKTEST_FOR_SIGNALS=false

# DuckDNS / Caddy (set your subdomain in Caddyfile)
# DOMAIN=signalapp.duckdns.org
